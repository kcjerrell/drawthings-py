class GenConfig(MutableMapping[GenConfigKey, object]):
    _d: ConfigDict

    def __init__(self, **kwargs: Unpack[ConfigDict]):
        self._d = ConfigDict(**kwargs)

    {% for type, props in groups["Gen"]["types"].items() %}
    @overload
    def __setitem__(self, key: {% if props|length > 3%}GenConfig{{ type }}Key{% else %}Literal[{% for prop in props %}"{{ prop.name }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}, value: {{ props[0].type }}) -> None: ...
    {% endfor %}
    @override
    def __setitem__(self, key: GenConfigKey, value: object) -> None:
        self._d[key] = value

    @override
    def __delitem__(self, key: GenConfigKey) -> None:
        del self._d[key]

    @override
    def __iter__(self) -> Iterator[GenConfigKey]:
        return cast(Iterator[GenConfigKey], iter(self._d))

    @override
    def __len__(self) -> int:
        return len(self._d)

    {% for type, props in groups["Gen"]["types"].items() %}
    @overload
    def __getitem__(self, key: {% if props|length > 3%}GenConfig{{ type }}Key{% else %}Literal[{% for prop in props %}"{{ prop.name }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}) -> {{ props[0].type }}: ...
    {% endfor %}
    @override
    def __getitem__(self, key: GenConfigKey) -> object:
        return self._d[key]

    {% for prop in groups["Gen"]["props"] %}
    @property
    def {{ prop.name }}(self) -> {{ prop.type }}:
        """{{ prop.desc() }}"""
        return self._d.get("{{ prop.name }}", {{ prop.default }})
    @{{ prop.name }}.setter
    def {{ prop.name }}(self, value: {{ prop.type }}):
        self._d["{{ prop.name }}"] = value
    {% endfor %}


