        """{{ prop.get_desc(True) }}"""
        return self._d.get("{{ prop.name }}", {{ prop.default }})
    @{{ prop.name }}.setter
    def {{ prop.name }}(self, value: {{ prop.type }}):
        self._d["{{ prop.name }}"] = value
